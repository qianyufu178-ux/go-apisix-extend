  <diagram id="agent" name="03 采集端状态机">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3_start" value="启动 cam-push" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_list" value="设备枚举&#10;-list / -device auto&#10;解析 dshow 列表，跳过音频段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3_startff" value="启动 FFmpeg&#10;dshow + libx264 + mpegts&#10;CREATE_NO_WINDOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3_connect" value="建连&#10;PUT /ingest/live/{name}&#10;chunked + X-Ingest-Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="100" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3_stdio" value="ffmpeg stdout → HTTP body&#10;5s 采样打印 Mbps / 累计 MB&#10;stderr 逐行转发 ffmpeg| 前缀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="240" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_break" value="连接断开 / 异常退出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_cleanup" value="必清理&#10;Kill() + Wait()，不留野 ffmpeg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="200" y="250" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_backoff" value="指数退避&#10;1s → 2s → 4s … 上限 10s&#10;稳定 &gt; 30s 则重置为 1s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="200" y="380" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_sig" value="Ctrl+C / SIGTERM" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="420" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_stop" value="停止子进程 → 退出" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="530" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_note" value="关键点：&#10;1) 401 / 409 在网关读 body 之前就返回 → 错误令牌或重复推流不会白推一帧。&#10;2) 退避重置条件是「上一次连接稳定跑过 30 秒」，避免偶发抖动后重连间隔越拖越长。&#10;3) 确定性错误（设备被占用等）会以固定节奏在日志里复现，便于现场定位。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="900" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p3_e1" style="html=1;endArrow=block;" edge="1" parent="1" source="p3_start" target="p3_list">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e2" style="html=1;endArrow=block;" edge="1" parent="1" source="p3_list" target="p3_startff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e3" style="html=1;endArrow=block;" edge="1" parent="1" source="p3_startff" target="p3_connect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e4" value="200 → 推流中" style="html=1;endArrow=block;" edge="1" parent="1" source="p3_connect" target="p3_stdio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e5" value="异常" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p3_stdio" target="p3_break">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e6" value="错误码 / 连接失败" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p3_connect" target="p3_break">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e7" style="html=1;endArrow=block;" edge="1" parent="1" source="p3_break" target="p3_cleanup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e8" style="html=1;endArrow=block;" edge="1" parent="1" source="p3_cleanup" target="p3_backoff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e9" value="重连" style="html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="p3_backoff" target="p3_startff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_e10" value="任意状态收到信号" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p3_sig" target="p3_stop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nexus" name="04 转码分发内部">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p4_src" value="输入源&#10;HTTP(网关) / RTSP / 文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_probe" value="ffprobe 探源&#10;宽 / 高 / 帧率&#10;失败回退标称规格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_fit" value="FitToSource 收敛&#10;只降不升 · 等比 · 偶数对齐&#10;码率 = 像素 × fps × 0.12bpp&#10;夹在 2.5 – 8 Mbps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_mode" value="编码轨选择" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4_gpu" value="GPU_ACCELERATION&#10;h264_nvenc&#10;p5 / tune hq / -bf 0&#10;CBR · spatial-aq 1 · profile high" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="250" y="390" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_cpu" value="CPU_SELF_HEALING&#10;libx264 veryfast&#10;540p @ 12fps 兜底" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="250" y="510" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_ff" value="FFmpeg 子进程&#10;lanczos 缩放 → H.264 → RTP&#10;-f rtp rtp://127.0.0.1:5004" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="390" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_guard" value="守护 / 退避重启&#10;restarts 计数 · 优雅退出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="520" y="510" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_hwprobe" value="硬件探针（3 级）&#10;1 ffmpeg 存在&#10;2 nvenc 已编译&#10;3 真跑 5 帧最小硬编码&#10;失败翻译成可执行结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_rtp" value="RTP 中转&#10;监听 5004，逐包解析&#10;统一改写 SSRC / seq / ts&#10;计数：received / forwarded / dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="810" y="390" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4_pion" value="Pion WebRTC v4&#10;单 Track 多 Peer&#10;一次 WriteRTP 复制给所有浏览器&#10;非 Trickle · RTCP 读泵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1100" y="390" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4_br" value="浏览器 video 标签&#10;无插件播放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="230" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_stat" value="/api/status 全量快照&#10;probe · transcoder · rtp · webrtc · ws · source_caps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="810" y="130" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_ws" value="/ws/telemetry 1Hz 广播&#10;慢客户端直接丢弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="810" y="240" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_dash" value="Vue3 大屏&#10;ECharts 动态坐标轴 + 状态条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="120" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_note" value="排障存档：FFmpeg 8 下 -tune hq 与 -zerolatency 1 并存 → NVENC 首帧 generic error 20，进程秒退、守护无限重启。&#10;改为 -bf 0 后：45 秒内 31 次崩溃 → 11.2 小时累计 1 次；1280x720@30 / 3318 kbps / rtp dropped=0。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1310" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p4_e1" style="html=1;endArrow=block;" edge="1" parent="1" source="p4_src" target="p4_probe">
