  <diagram id="gateway" name="02 网关内部">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2_req" value="http.Request&#10;ServeHTTP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_pool" value="gwctx.GetContext()&#10;sync.Pool（data map 预分配 8）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_match" value="router.Match(method, path)&#10;atomic.Value.Load → 快照&#10;exact[method+&quot;:&quot;+path]&#10;0 allocs / 0 locks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2_404" value="404 route not found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_pipe" value="pipeline.Execute(ctx)&#10;洋葱插件链 Next() / Abort()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p2_plugBox" value="内置插件（可组合）" style="swimlane;html=1;startSize=26;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="290" y="400" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p2_auth" value="auth&#10;Bearer 校验 → 401 并 Abort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p2_plugBox">
          <mxGeometry x="20" y="40" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2_rl" value="rate_limit&#10;令牌桶 CAS 更新，无互斥锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p2_plugBox">
          <mxGeometry x="20" y="100" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2_met" value="metrics&#10;原子计数 → /stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p2_plugBox">
          <mxGeometry x="20" y="160" width="260" height="45" as="geometry" />
        </mxCell>

        <mxCell id="p2_local" value="backend 是 local:// ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_abort" value="ctx.IsAborted() → 直接返回&#10;不转发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_handler" value="进程内 Handler（live.Hub）&#10;单发布者 → 多订阅者扇出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="270" y="530" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_rp" value="httputil.ReverseProxy&#10;director: 重写 URL + X-Real-IP / X-Forwarded-*&#10;errorHandler: 502 统一错误体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="530" y="530" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_put" value="defer gwctx.PutContext(ctx)&#10;Reset() 后归还池（handlers 切片复用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="640" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p2_cfg" value="配置 Watcher&#10;文件变更 → 解析校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_write" value="AddRoute / RemoveRoute&#10;COW 复制整表 → atomic.Store&#10;写成本 O(表长)&#10;实测 10/100/1000 条：1.09/4.11/25.33 µs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="170" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_hub" value="live.Hub 复用&#10;热更新不打断在线推拉流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="300" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_legend" value="读路径（每请求）：原子加载 + 一次 map 查找 + 池化上下文 → 实测 0 allocs/op&#10;写路径（热更新）：复制整表后原子替换 → 在途请求继续用旧快照，无锁无阻塞&#10;因此「热更新」与「高并发读」互不干扰。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="830" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p2_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p2_req" target="p2_pool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p2_pool" target="p2_match">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e3" value="未命中" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_match" target="p2_404">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e4" value="命中" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_match" target="p2_pipe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e5" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_pipe" target="p2_plugBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e6" value="Abort" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p2_plugBox" target="p2_abort">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e7" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_pipe" target="p2_local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e8" value="是" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_local" target="p2_handler">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e9" value="否" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_local" target="p2_rp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e10" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_handler" target="p2_put">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e11" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_rp" target="p2_put">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e12" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_cfg" target="p2_write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e13" style="html=1;endArrow=block;" edge="1" parent="1" source="p2_write" target="p2_hub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e14" value="原子替换路由表" style="html=1;endArrow=open;dashed=1;" edge="1" parent="1" source="p2_write" target="p2_match">
